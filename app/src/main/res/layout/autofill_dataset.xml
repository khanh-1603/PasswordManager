<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutDatasetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- Container bọc nội dung item: Dùng RemoteViews.setInt(..., "setBackgroundResource", ...) để đổi nền -->
    <LinearLayout
        android:id="@+id/layoutItemContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_autofill_normal_item">

        <!-- 1. Header phân mục "TÀI KHOẢN GẦN ĐÂY" (Visible khi là lastUsed) -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivHeaderIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_history"
                android:contentDescription="@null"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TÀI KHOẢN GẦN ĐÂY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue"
                android:letterSpacing="0.04" />

            <!-- Huy hiệu "VỪA DÙNG" nổi bật -->
            <TextView
                android:id="@+id/tvRecentBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VỪA DÙNG"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue"
                android:background="@drawable/bg_autofill_badge"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <!-- 2. Hàng nội dung chính (Icon + Username + Subtitle) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Dải vạch màu nhấn bên trái: Dùng ImageView thay cho View -->
            <ImageView
                android:id="@+id/viewAccentIndicator"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:src="@color/primary_blue"
                android:contentDescription="@null"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Thông tin tài khoản -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivAutofillIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="user@example.com"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Vault Logic"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivSecurityLock"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shield_lock_blue"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 3. ĐƯỜNG KẺ PHÂN CÁCH: Dùng ImageView 1dp thay vì View -->
    <ImageView
        android:id="@+id/viewBottomDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:src="@color/outline_variant"
        android:contentDescription="@null"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>